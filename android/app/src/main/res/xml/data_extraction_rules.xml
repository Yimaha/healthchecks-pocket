<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep the app's data (saved projects with API keys) out of Google cloud
  backup and phone-to-phone transfer (Android 12+). The values are encrypted
  with a Keystore key that never leaves this device, so a restored copy
  couldn't be decrypted anyway; after a reinstall or on a new phone, re-enter
  the API key. android:allowBackup="false" covers Android 11 and older.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
